name: Build Linux perceive binary

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build-linux-apps:
    name: Build perceive (Linux)
    runs-on: ubuntu-latest
    timeout-minutes: 60
    env:
      MLM_LICENSE_TOKEN: ${{ secrets.MLM_LICENSE_TOKEN }}

    steps:
      - name: Check out repository
        uses: actions/checkout@v5

      - name: Validate MATLAB batch licensing token is configured
        shell: bash
        run: |
          if [ -z "${MLM_LICENSE_TOKEN:-}" ]; then
            echo "Missing secret MLM_LICENSE_TOKEN."
            echo "MATLAB Compiler builds in GitHub Actions require a batch licensing token."
            echo "Add repository secret: MLM_LICENSE_TOKEN"
            exit 1
          fi

      - name: Set up MATLAB
        uses: matlab-actions/setup-matlab@v3
        with:
          products: MATLAB_Compiler

      - name: Preflight check MATLAB Compiler availability
        uses: matlab-actions/run-command@v3
        with:
          command: |
            fprintf('MATLAB version: %s\n', version);
            v = ver('compiler');
            if isempty(v)
                error(['MATLAB Compiler is not installed on this runner. ', ...
                    'Ensure setup-matlab installs MATLAB_Compiler and, if needed, set MLM_LICENSE_TOKEN.']);
            end
            fprintf('MATLAB Compiler installed: %s %s\n', v.Name, v.Version);
            try
                tf = license('test','Compiler');
                fprintf('Compiler license test: %d\n', tf);
                if ~tf
                    warning('Compiler license unavailable. You may need MLM_LICENSE_TOKEN in repository secrets.');
                end
            catch ME
                warning('Could not run license test for Compiler: %s', ME.message);
            end

      - name: Build perceive standalone app
        uses: matlab-actions/run-command@v3
        with:
          command: cd("toolbox"); ci_build_perceive_standalone("linux")

      - name: Upload MATLAB build logs
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: perceive-linux-build-logs
          path: |
            toolbox/linux_build.log
            toolbox/linux_build_error.txt
          if-no-files-found: ignore

      - name: Collect Linux binary artifacts
        shell: bash
        run: |
          python3 - <<'PY'
          import pathlib, shutil, stat

          root = pathlib.Path("toolbox")
          out = pathlib.Path("artifacts/linux")
          out.mkdir(parents=True, exist_ok=True)

          target = "perceive"
          candidates = []
          for p in root.rglob(target):
              if not p.is_file():
                  continue
              if p.suffix == "" and (p.stat().st_mode & stat.S_IXUSR):
                  candidates.append(p)
          if not candidates:
              raise SystemExit(f"No Linux executable found for {target} under toolbox after build.")
          exe = max(candidates, key=lambda p: p.stat().st_mtime)
          dest = out / target
          shutil.copy2(exe, dest)
          dest.chmod(dest.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
          print(f"Collected Linux executable: {dest}")
          PY

      - name: Place Linux executables into install folder
        shell: bash
        run: |
          mkdir -p install
          cp -f artifacts/linux/perceive install/perceive
          chmod +x install/perceive

      - name: Commit updated install executable to repository
        uses: stefanzweifel/git-auto-commit-action@v5
        with:
          commit_message: "chore: update linux standalone perceive"
          file_pattern: install/perceive

      - name: Upload Linux executable artifacts
        uses: actions/upload-artifact@v4
        with:
          name: perceive-linux-bins
          path: artifacts/linux/
          if-no-files-found: error
